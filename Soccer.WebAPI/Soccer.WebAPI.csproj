<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <SpaRoot>..\react.client\</SpaRoot>
    <SpaProxyServerUrl>https://localhost:3000</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Soccer.Application\Soccer.Application.csproj" />
    <ProjectReference Include="..\Soccer.Infrastructure\Soccer.Infrastructure.csproj" />
    <ProjectReference Include="..\Soccer.Common\Soccer.Common.csproj" />
  </ItemGroup>

  <Target Name="EnsureNodeModulesInstalled" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules')">

    <Message Importance="high" Text="Restoring React dependencies using npm..." />

    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />

  </Target>

</Project>
