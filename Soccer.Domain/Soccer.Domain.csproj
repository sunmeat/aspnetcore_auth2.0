<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Domain - центр Clean Architecture. Жодних посилань на інші проєкти рішення
    і жодних NuGet-пакетів (навіть на Entity Framework Core): сутності — це
    прості POCO-класи (Player, Team), а контракти доступу до даних
    (IRepository, IUnitOfWork) оголошені тут за принципом інверсії залежностей -
    Infrastructure згодом реалізує ці інтерфейси, а не навпаки.
    
                   ┌──────────────────┐
                   │   Presentation   │
                   └───────┬──░───────┘
                           │  ░
             ┌─────────────┘  ░ (тільки для DI)
             │                ░
             ▼                ▼
    ┌──────────────────┐  ┌──────────────────┐
    │   Application    │  │  Infrastructure  │
    └────────┬─────────┘  └─────────┬────────┘
             │                      │
             └───────────┬──────────┘
                         │
                         ▼
            ┌────────────────────────┐
            │         Domain         │  (Центр)
            └────────────────────────┘
            
  -->

</Project>